{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameBlade",
  "version": "0.1.0",
  "identifier": "io.gameblade.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameBlade",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https: http:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Browse and download your GameBlade library",
    "longDescription": "Desktop client for a self-hosted GameBlade game archive, with resumable multi-connection downloads.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
