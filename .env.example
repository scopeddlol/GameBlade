# Copy to .env and edit. Everything here is optional except LIBRARY_PATH.
# docker compose reads this file automatically.

# ---------------------------------------------------------------------------
# Library
# ---------------------------------------------------------------------------
# Absolute path ON THE HOST to your archived games. Mounted read-only at
# /library inside the container.
LIBRARY_PATH=/mnt/games

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host port for direct/LAN access.
HTTP_PORT=8080

# Coordinator image only: Caddy listens here. Set a public DNS name (with its
# A/AAAA record pointed at the VPS) for automatic HTTPS, or :8080 for HTTP-only.
CADDY_ADDRESS=:8080
HTTPS_PORT=443

# Coordinator fallback relay, e.g. games.example.com:47821. Leave blank to use
# direct node/client paths only.
RELAY_ENDPOINT=

TZ=Etc/UTC
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Reverse proxy (Pangolin, Traefik, nginx, Caddy)
# ---------------------------------------------------------------------------
# Must be true behind a proxy, otherwise every client looks like the proxy's IP
# and rate limiting buckets all users together.
TRUST_PROXY=true

# Only set when serving under a sub-path, e.g. BASE_PATH=/gameblade.
# Leave empty when the app owns the whole hostname.
BASE_PATH=

# auto = mark cookies Secure when X-Forwarded-Proto is https.
SECURE_COOKIES=auto

# ---------------------------------------------------------------------------
# First-run administrator (optional)
# ---------------------------------------------------------------------------
# Applied only while the database has no accounts. If you leave these unset,
# the first visit to the web UI walks you through creating the admin instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-something-long

# Invite-only by default. Leave false unless you want open registration.
ALLOW_SELF_REGISTRATION=false

# ---------------------------------------------------------------------------
# Metadata providers (optional — can also be set in Admin -> Metadata)
# ---------------------------------------------------------------------------
# IGDB is powered by Twitch: create an app at https://dev.twitch.tv/console/apps
# to get a client ID and secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# From your SteamGridDB account preferences: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# Reads published achievement lists so games can have achievements. Only public
# game metadata is requested — no player data, and no Steam account is linked.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ---------------------------------------------------------------------------
# Desktop client
# ---------------------------------------------------------------------------
# Where the landing page's "Download for Windows" button points. Leave empty
# to hide the button until you have published an installer.
CLIENT_DOWNLOAD_URL=

# ---------------------------------------------------------------------------
# User storage quotas
# ---------------------------------------------------------------------------
# Per-account ceilings, in megabytes. 0 disables the limit entirely.
# Media covers avatars, screenshots and clips; saves covers cloud save archives.
MEDIA_QUOTA_MB=20480
SAVE_QUOTA_MB=10240

# ---------------------------------------------------------------------------
# Scanning
# ---------------------------------------------------------------------------
SCAN_ON_START=true
# Rescan interval in minutes; 0 disables scheduled scans.
SCAN_INTERVAL_MINUTES=360

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------
# Signing key for download tokens. Generated and persisted automatically if
# unset; set it explicitly only if you run multiple replicas.
# SESSION_SECRET=
